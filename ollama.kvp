App.WorkingDir=
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=-c "exec python3 -u \"{{$FullBaseDir}}ollamachat.py\""
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"WEBUI_PORT":"{{$WebUIPort}}","WEBUI_PASSWORD":"{{WebUIPassword}}","WEBUI_DATA":"{{$FullBaseDir}}chatdata","OLLAMA_BIN":"{{$FullBaseDir}}bin/ollama","WEB_SEARCH":"{{WebSearch}}","SEARXNG_URL":"{{SearxngUrl}}","OLLAMA_API_KEY":"{{OllamaApiKey}}","OLLAMA_HOST":"{{OllamaBind}}:{{$APIPort}}","OLLAMA_MODELS":"{{$FullBaseDir}}models","OLLAMA_ORIGINS":"{{Origins}}","OLLAMA_KEEP_ALIVE":"{{KeepAlive}}","OLLAMA_CONTEXT_LENGTH":"{{ContextLength}}","OLLAMA_NUM_PARALLEL":"{{NumParallel}}","OLLAMA_MAX_LOADED_MODELS":"{{MaxLoadedModels}}","OLLAMA_MAX_QUEUE":"{{MaxQueue}}","OLLAMA_LOAD_TIMEOUT":"{{LoadTimeout}}","OLLAMA_FLASH_ATTENTION":"{{FlashAttention}}","OLLAMA_KV_CACHE_TYPE":"{{KvCacheType}}","OLLAMA_NOPRUNE":"{{NoPrune}}","OLLAMA_MULTIUSER_CACHE":"{{MultiuserCache}}","OLLAMA_NO_CLOUD":"{{NoCloud}}","OLLAMA_DEBUG":"{{Debug}}","HOME":"{{$FullBaseDir}}"}
