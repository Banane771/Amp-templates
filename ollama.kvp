Meta.DisplayName=Ollama + OllamaChat
Meta.Description=Ollama (CPU) et son interface web de chat OllamaChat, dans un conteneur géré par AMP
Meta.OS=Linux
Meta.Arch=x86_64
Meta.Author=perso
Meta.URL=https://ollama.com
Meta.DisplayImageSource=url:https://ollama.com/public/ollama.png
Meta.EndpointURIFormat=http://{ip}:{GenericModule.App.Ports.$WebUIPort}
Meta.ConfigManifest=ollamaconfig.json
Meta.MetaConfigManifest=
Meta.ConfigRoot=ollama.kvp
Meta.MinAMPVersion=2.4.6.0
Meta.SpecificDockerImage=
Meta.DockerRequired=False
Meta.ContainerPolicy=RecommendedOnLinux
Meta.ContainerPolicyReason=Le conteneur géré par AMP isole Ollama et permet de limiter sa RAM et son CPU depuis AMP.
Meta.Prerequsites=[]
Meta.ExtraContainerPackages=["zstd","python3"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
App.DisplayName=Ollama
App.RootDir=./ollama/
App.BaseDirectory=./ollama/
App.ExecutableLinux=/usr/bin/python3
App.ExecutableWin=
App.WorkingDir=
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=-u {{$FullBaseDir}}/ollamachat.py
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"WEBUI_PORT":"{{$WebUIPort}}","WEBUI_PASSWORD":"{{$WebUIPassword}}","WEBUI_DATA":"{{$FullBaseDir}}/chatdata","OLLAMA_BIN":"{{$FullBaseDir}}/bin/ollama","WEB_SEARCH":"{{$WebSearch}}","SEARXNG_URL":"{{$SearxngUrl}}","OLLAMA_API_KEY":"{{$OllamaApiKey}}","OLLAMA_HOST":"{{$OllamaBind}}:{{$APIPort}}","OLLAMA_MODELS":"{{$FullBaseDir}}/models","OLLAMA_ORIGINS":"{{$Origins}}","OLLAMA_KEEP_ALIVE":"{{$KeepAlive}}","OLLAMA_CONTEXT_LENGTH":"{{$ContextLength}}","OLLAMA_NUM_PARALLEL":"{{$NumParallel}}","OLLAMA_MAX_LOADED_MODELS":"{{$MaxLoadedModels}}","OLLAMA_MAX_QUEUE":"{{$MaxQueue}}","OLLAMA_LOAD_TIMEOUT":"{{$LoadTimeout}}","OLLAMA_FLASH_ATTENTION":"{{$FlashAttention}}","OLLAMA_KV_CACHE_TYPE":"{{$KvCacheType}}","OLLAMA_NOPRUNE":"{{$NoPrune}}","OLLAMA_MULTIUSER_CACHE":"{{$MultiuserCache}}","OLLAMA_NO_CLOUD":"{{$NoCloud}}","OLLAMA_DEBUG":"{{$Debug}}"}
App.ExitMethod=OS_CLOSE
App.ExitTimeout=30
App.ExitString=
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.ApplicationIPBinding=0.0.0.0
App.MaxUsers=0
App.AdminPortRef=
App.AdminMethod=None
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=
App.Ports=@IncludeJson[ollamaports.json]
App.UpdateSources=@IncludeJson[ollamaupdates.json]
Console.AppReadyRegex=^.*Listening on .*$
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^$
Console.UserJoinRegex=
Console.UserLeaveRegex=
Console.UserChatRegex=
Console.UpdateAvailableRegex=
Console.SuppressLogAtStartup=False
Limits.SleepMode=False
Limits.SleepOnStart=False
